---
interface Props {
  brandName: string;
  faq: { question: string; answer: string }[];
}
const { brandName, faq } = Astro.props;

const hasFaq = Array.isArray(faq) && faq.length > 0;

const items = faq
  .map((f) => ({
    question: String(f.question ?? '').trim(),
    answer: String(f.answer ?? '').trim(),
  }))
  .filter((f) => f.question && f.answer);

const showSection = items.length > 0;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---
{showSection && (
<section class="py-16">
  <div class="container mx-auto px-4">
    <div class="mb-8 flex items-center gap-3">
      <span class="h-8 w-1 bg-tomato-500 rounded-full"></span>
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">{brandName} FAQ</h2>
    </div>
    <div class="max-w-3xl space-y-3">
      {items.map((item) => (
        <details class="group rounded-2xl bg-white dark:bg-gray-800 shadow-sm border border-gray-100 dark:border-gray-700 open:border-tomato-500/40">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 text-base font-bold text-gray-900 dark:text-white list-none">
            {item.question}
            <svg class="h-5 w-5 shrink-0 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="px-6 pb-5 text-sm leading-relaxed text-gray-600 dark:text-gray-300">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
)}