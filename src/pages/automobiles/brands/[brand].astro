---
import Layout from '../../../layouts/BaseLayout.astro';
import * as fs from 'node:fs';
import * as path from 'node:path';
import brandsData from '../../../data/brands.json';
import { hasText, readBrandContent, slugifyBrand } from '../../../lib/brand-content.js';

export function getStaticPaths() {
  return brandsData.map((brand) => {
    const [, , url, name] = brand;
    const slug = slugifyBrand(name);

    return {
      params: { brand: slug },
      props: {
        brandName: name,
        brandUrl: url,
        brandLogo: `/images/brands/${slug}.jpg`,
        brandSlug: slug,
      },
    };
  });
}

const { brandName, brandUrl, brandLogo, brandSlug } = Astro.props;

let brandData = null;
try {
  brandData = readBrandContent(brandSlug);
} catch (error) {
  console.error(`Error loading enriched brand content for ${brandSlug}:`, error);
}

let models = [];
const modelsPath = path.join(process.cwd(), 'src', 'data', brandSlug, 'models.json');
if (fs.existsSync(modelsPath)) {
  try {
    const parsed = JSON.parse(fs.readFileSync(modelsPath, 'utf-8'));
    if (Array.isArray(parsed)) models = parsed;
  } catch (error) {
    console.error(`Error loading models for ${brandSlug}:`, error);
  }
}

function modelLookupKey(value) {
  return String(value ?? '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
}

const modelRoutes = new Map();
for (const model of models) {
  if (!model?.name || model.id === 'placeholder-model') continue;
  const routeKey = model.slug || model.id;
  if (!routeKey) continue;
  modelRoutes.set(modelLookupKey(model.name), `/automobiles/${brandSlug}-${routeKey}`);
}

const popularModels = Array.isArray(brandData?.popular_models)
  ? brandData.popular_models.map((name) => ({ name, href: modelRoutes.get(modelLookupKey(name)) || null }))
  : [];

const pageTitle = brandData?.seo_title || `${brandName} ECU Documentation | EcuDocs.com`;
const pageDescription = brandData?.seo_description || `Browse ECU documentation and technical resources currently indexed for ${brandName} vehicles.`;
const heroDescription = brandData?.description || `Browse the ${brandName} vehicle models and ECU-related technical resources currently available on ECU Docs.`;
const canonicalUrl = `/automobiles/brands/${brandSlug}`;

const relatedBrandMap = new Map(brandsData.map((row) => [slugifyBrand(row[3]), row[3]]));
const relatedBrands = Array.isArray(brandData?.related_brands)
  ? brandData.related_brands
      .filter((slug) => relatedBrandMap.has(slug) && slug !== brandSlug)
      .map((slug) => ({ slug, name: relatedBrandMap.get(slug) }))
  : [];

const faqItems = Array.isArray(brandData?.faq)
  ? brandData.faq.filter((item) => hasText(item?.question) && hasText(item?.answer))
  : [];
const faqJsonLd = faqItems.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;

const sourceLinks = Array.isArray(brandData?.sources)
  ? brandData.sources.filter((url) => typeof url === 'string' && /^https?:\/\//i.test(url))
  : [];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={`${brandName} ECU, ${brandName} documentation, ${brandName} wiring diagrams, ${brandName} diagnostics, ${brandName} pinouts`}
  canonicalUrl={canonicalUrl}
>
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <div class="min-h-screen bg-gray-50 dark:bg-charcoal-900">
    <header class="relative overflow-hidden bg-charcoal-500 py-16 text-white sm:py-24">
      <div class="absolute inset-0 opacity-10">
        <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <path d="M0 100 L100 0 L100 100 Z" fill="currentColor"></path>
        </svg>
      </div>

      <div class="container mx-auto px-4 relative z-10">
        <nav class="mb-8 flex text-sm font-medium text-charcoal-200" aria-label="Breadcrumb">
          <ol class="flex items-center space-x-2">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li><span class="px-2">/</span></li>
            <li><a href="/automobiles/brands" class="hover:text-white transition-colors">Brands</a></li>
            <li><span class="px-2">/</span></li>
            <li class="text-white" aria-current="page">{brandName}</li>
          </ol>
        </nav>

        <div class="flex flex-col items-center text-center sm:flex-row sm:items-start sm:text-left gap-8">
          <div class="relative h-32 w-32 shrink-0 rounded-2xl bg-white p-4 shadow-xl sm:h-40 sm:w-40">
            {brandLogo && (
              <img
                src={brandLogo}
                alt={`${brandName} logo`}
                class="h-full w-full object-contain"
                onerror="this.src='https://i.imgur.com/GQePUq0.png'"
              />
            )}
          </div>
          <div class="max-w-3xl">
            <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl mb-4">{brandName} ECU Documentation</h1>
            <p class="text-lg text-charcoal-100 mb-6 max-w-2xl">{heroDescription}</p>
            <div class="flex flex-wrap gap-4 justify-center sm:justify-start">
              {brandUrl && (
                <a href={brandUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-lg bg-tomato-500 px-6 py-3 text-sm font-bold shadow-lg hover:bg-tomato-600 transition-all transform hover:-translate-y-1">
                  Manufacturer Reference →
                </a>
              )}
              <div class="inline-flex items-center rounded-lg bg-charcoal-700/50 backdrop-blur px-6 py-3 text-sm font-medium border border-charcoal-400">
                {models.length} Models Indexed
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="container mx-auto px-4 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
        <aside class="lg:col-span-1 space-y-8">
          <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Brand Information</h2>
            <div class="space-y-4">
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-gray-400">Manufacturer</span>
                <span class="text-gray-700 dark:text-gray-300 font-medium">{brandName}</span>
              </div>
              {brandData?.country && <div><span class="block text-xs font-bold uppercase tracking-wider text-gray-400">Country</span><span class="text-gray-700 dark:text-gray-300 font-medium">{brandData.country}</span></div>}
              {brandData?.founded && <div><span class="block text-xs font-bold uppercase tracking-wider text-gray-400">Founded</span><span class="text-gray-700 dark:text-gray-300 font-medium">{brandData.founded}</span></div>}
              {brandData?.parent_company && <div><span class="block text-xs font-bold uppercase tracking-wider text-gray-400">Parent company</span><span class="text-gray-700 dark:text-gray-300 font-medium">{brandData.parent_company}</span></div>}
              {brandData?.current_status && <div><span class="block text-xs font-bold uppercase tracking-wider text-gray-400">Status</span><span class="text-gray-700 dark:text-gray-300 font-medium capitalize">{brandData.current_status}</span></div>}
            </div>
          </div>

          <div class="rounded-2xl bg-gradient-to-br from-charcoal-800 to-charcoal-900 p-6 text-white shadow-lg">
            <h3 class="text-lg font-bold mb-2">Need a Specific ECU?</h3>
            <p class="text-sm text-charcoal-200 mb-4">If your {brandName} model is missing, contact our technical team for support.</p>
            <a href="/contact" class="block w-full rounded-lg bg-white/10 py-2 text-center text-sm font-bold hover:bg-white/20 transition-colors">Request Documentation</a>
          </div>
        </aside>

        <div class="lg:col-span-3 space-y-10">
          {hasText(brandData?.history) && (
            <section class="rounded-2xl bg-white dark:bg-gray-800 p-8 shadow-sm border border-gray-100 dark:border-gray-700">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">{brandName} Overview</h2>
              <p class="leading-7 text-gray-600 dark:text-gray-300">{brandData.history}</p>
            </section>
          )}

          {(Array.isArray(brandData?.vehicle_types) || popularModels.length > 0) && (
            <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {Array.isArray(brandData?.vehicle_types) && brandData.vehicle_types.length > 0 && (
                <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-100 dark:border-gray-700">
                  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Vehicle Types</h2>
                  <ul class="space-y-2 text-gray-600 dark:text-gray-300">{brandData.vehicle_types.map((item) => <li>• {item}</li>)}</ul>
                </div>
              )}
              {popularModels.length > 0 && (
                <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-100 dark:border-gray-700">
                  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Popular Models</h2>
                  <ul class="space-y-2 text-gray-600 dark:text-gray-300">
                    {popularModels.map((item) => <li>• {item.href ? <a href={item.href} class="hover:text-tomato-500 font-medium">{item.name}</a> : item.name}</li>)}
                  </ul>
                </div>
              )}
            </section>
          )}

          {(hasText(brandData?.ecu_information) || (Array.isArray(brandData?.common_ecu_manufacturers) && brandData.common_ecu_manufacturers.length > 0)) && (
            <section class="rounded-2xl bg-white dark:bg-gray-800 p-8 shadow-sm border border-gray-100 dark:border-gray-700">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">ECU and Vehicle Electronics</h2>
              {hasText(brandData?.ecu_information) && <p class="leading-7 text-gray-600 dark:text-gray-300">{brandData.ecu_information}</p>}
              {Array.isArray(brandData?.common_ecu_manufacturers) && brandData.common_ecu_manufacturers.length > 0 && (
                <div class="mt-6"><h3 class="font-bold text-gray-900 dark:text-white mb-2">Common ECU suppliers</h3><p class="text-gray-600 dark:text-gray-300">{brandData.common_ecu_manufacturers.join(', ')}</p></div>
              )}
            </section>
          )}

          <section id="vehicle-library">
            <div class="mb-8"><h2 class="text-3xl font-bold text-gray-900 dark:text-white">{brandName} Vehicle Library</h2></div>
            {models.length > 0 ? (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {models.map((model) => (
                  <div class="group relative flex flex-col rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-100 dark:border-gray-700 transition-all hover:shadow-xl hover:-translate-y-1">
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-tomato-500 transition-colors mb-3">{model.name}</h3>
                    {model.engine_name && <p class="mb-2 text-sm text-gray-500 dark:text-gray-400">Engine: {model.engine_name}</p>}
                    <p class="mb-6 line-clamp-2 text-sm text-gray-600 dark:text-gray-400">{model.description || `Technical resources indexed for the ${model.name}.`}</p>
                    <div class="mt-auto pt-4 border-t border-gray-50 dark:border-gray-700">
                      {model.id === 'placeholder-model' ? <span class="text-sm font-medium text-gray-400">Coming Soon</span> : <a href={`/automobiles/${brandSlug}-${model.slug || model.id}`} class="text-sm font-bold text-tomato-500 hover:text-tomato-600">View Full Specifications →</a>}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="rounded-3xl bg-charcoal-50 dark:bg-gray-800/50 p-12 text-center border-2 border-dashed border-gray-200 dark:border-gray-700">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">No {brandName} Models Listed Yet</h3>
                <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-sm mx-auto">No model-level resources are currently indexed for this manufacturer.</p>
                <a href="/contact" class="inline-flex items-center rounded-xl bg-charcoal-500 px-8 py-3 text-sm font-bold text-white hover:bg-charcoal-600 transition-colors shadow-lg">Email Technical Support</a>
              </div>
            )}
          </section>

          {relatedBrands.length > 0 && (
            <section class="rounded-2xl bg-white dark:bg-gray-800 p-8 shadow-sm border border-gray-100 dark:border-gray-700">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Related Brands</h2>
              <div class="flex flex-wrap gap-3">{relatedBrands.map((item) => <a href={`/automobiles/brands/${item.slug}`} class="rounded-lg border border-gray-200 dark:border-gray-700 px-4 py-2 text-sm font-semibold hover:border-tomato-500 hover:text-tomato-500">{item.name}</a>)}</div>
            </section>
          )}

          {faqItems.length > 0 && (
            <section class="rounded-2xl bg-white dark:bg-gray-800 p-8 shadow-sm border border-gray-100 dark:border-gray-700">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Frequently Asked Questions</h2>
              <div class="space-y-6">{faqItems.map((item) => <article><h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{item.question}</h3><p class="leading-7 text-gray-600 dark:text-gray-300">{item.answer}</p></article>)}</div>
            </section>
          )}

          {sourceLinks.length > 0 && (
            <section class="rounded-2xl bg-white dark:bg-gray-800 p-8 shadow-sm border border-gray-100 dark:border-gray-700">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Sources</h2>
              <ul class="space-y-2 text-sm">{sourceLinks.map((url) => <li><a href={url} target="_blank" rel="noopener noreferrer" class="text-tomato-500 hover:text-tomato-600 break-all">{url}</a></li>)}</ul>
            </section>
          )}
        </div>
      </div>
    </main>
  </div>
</Layout>
