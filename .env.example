# Ollama server URL for AI-powered filename generation
OLLAMA_URL=http://ai.izdrail.com
OLLAMA_MODEL=mistral:7b

# DeepSeek API configuration for the brand content generation pipeline
# (scripts/generate-brands.mjs). The pipeline falls back to the MOCK provider
# (synthetic, non-promotable test data) when DEEPSEEK_API_KEY is not set.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=4000
